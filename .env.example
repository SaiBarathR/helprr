# Docker (the normal case): run `./scripts/setup-env.sh` from a clone, or place
# the downloaded helper beside this template and run `./setup-env.sh`. It creates
# `.env` with private permissions and generated required secrets. Leave DATABASE_URL
# and REDIS_URL unset — compose
# wires them to the bundled Postgres/Redis containers automatically.
# Local development (`npm run dev`): copy to `.env.local` instead and set the two
# URLs to the development stack's loopback ports, as the commented examples
# below show. Do not point them at the stable database.
# Helprr intentionally refuses to start while any required value still uses a
# shipped change-me/example credential. Startup errors name variables but never
# print their values.

# --- Required ---
# Docker: DO NOT set — the container builds it from POSTGRES_PASSWORD (or the
# password helprr-init made) and points it at the bundled `helprr-db` container. Setting it here overrides that
# (inside the container, `localhost` is the app itself — the app will crash-loop
# with "Can't reach database server"). Set only for local dev or an external DB.
# Local dev: the development stack publishes PostgreSQL on loopback port 5433,
# database `helprr_dev`.
# DATABASE_URL=postgresql://postgres:password-add-here@localhost:5433/helprr_dev

# Docker: DO NOT set — defaults to the bundled `helprr-redis` container.
# Set only for local dev or an external Redis. Local dev: the development stack
# publishes Redis on loopback port 6380.
# REDIS_URL=redis://localhost:6380

# Redis AUTH password. Redis is started with --requirepass ${REDIS_PASSWORD} and the
# app sends it as the client's AUTH password. With the bundled docker-compose.yml,
# leave it empty (or remove this file) and helprr-init makes one; a Node-only app
# refuses to start without it.
REDIS_PASSWORD=change-me-redis

# For docker-compose. Empty: helprr-init makes one. PostgreSQL reads it only when
# it creates the database, so never change or remove it afterwards. The default
# DATABASE_URL embeds this password — if it contains URL special characters
# (@ : / ? #), set DATABASE_URL explicitly, percent-encoded.
POSTGRES_PASSWORD=change-me-postgres

# Optional. Empty: the first admin is created in the browser on first open
# (do that before Helprr is reachable from the internet). Set: it seeds the
# bootstrap admin's password on first boot only (at least 15 characters;
# setup-env.sh --admin-password generates one). NOT checked at login afterward —
# login verifies the per-user scrypt hash stored in the DB. Changing this later
# and restarting does nothing unless HELPRR_ADMIN_PASSWORD_RESET=true.
APP_PASSWORD=
# Bootstrap admin login username (optional; defaults to "admin"). When set, the
# bootstrap admin is renamed to it at every start, including one created at /setup.
# HELPRR_ADMIN_USERNAME=admin
# Recovery only: set to true to force-reset the bootstrap admin's password from
# APP_PASSWORD on the next boot, then remove it (otherwise every reboot re-hashes
# from APP_PASSWORD and overwrites any password set in-app). Resets only the admin.
# HELPRR_ADMIN_PASSWORD_RESET=true
# IANA timezone. setup-env.sh fills in this computer's timezone.
TZ=Etc/UTC
LOG_DIR=/app/logs
# Host port for Helprr (default 3050). Change it when 3050 is already taken, or use
# 127.0.0.1:3050 to reach Helprr only through a reverse proxy on the same machine.
# HELPRR_PORT=3050

# Public HTTPS origin, required only for AniList OAuth in production.
# APP_ORIGIN=https://helprr.example.com
# Where Sonarr/Radarr can reach Helprr when Add Torrent sends them a .torrent
# file (they fetch it once). Plain http on your network is fine. Defaults to
# APP_ORIGIN; magnet links need neither.
# ARR_CALLBACK_ORIGIN=http://helprr.lan:3050
# Set only behind a trusted reverse proxy that sanitizes X-Forwarded-* headers.
# TRUST_FORWARDED_PROTO=true
# With TRUST_FORWARDED_PROTO: how many proxies in a row add to X-Forwarded-For
# (default 1). Helprr takes the visitor's address that many entries from the end.
# TRUSTED_PROXY_HOPS=2

# Secret used to sign the session cookie. Must be at least 32 characters — the
# app refuses to boot otherwise. Generate a strong value with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-32+-char-random-value


# --- Optional: Web Push (enables push notifications) ---
# Generate with: npx web-push generate-vapid-keys
# All three are runtime config — no rebuild needed after changing them.
# (The old NEXT_PUBLIC_VAPID_PUBLIC_KEY name is still accepted.)
# VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# --- Optional: images and authenticating proxies ---
# Comma-separated trusted external hosts allowed by the image proxy.
# EXTRA_ALLOWED_IMAGE_HOSTS=images.example.com
# Enables custom HTTP headers for supported services behind an auth proxy.
# HELPRR_CUSTOM_HEADERS=true
# Image and TMDB cache tuning (IMAGE_CACHE_*, IMAGE_*, TMDB_CACHE_*, CACHE_LOCK_TTL_MS)
# has sensible defaults. Change it only for a reason; every variable is in
# https://saibarathr.github.io/helprr/reference/cache/

# --- Optional: local development ---
# Extra origins allowed to reach the dev server (LAN IP, Tailscale hostname).
# Dev-only; ignored in production builds.
# ALLOWED_DEV_ORIGINS=192.168.0.20,my-machine.tailnet.ts.net

# --- Optional: Docker image version ---
# Published image tag used by docker-compose.yml (default: stable). Pin an exact
# version for reproducible deploys. Do NOT point this stack at `edge` — test
# development builds with the isolated dev stack (docker-compose.dev.yml) instead.
# HELPRR_VERSION=1.0.0

# --- Optional: Twitch archiver worker ---
# Runs only with this profile, which also needs a Twitch connection in Settings.
# COMPOSE_PROFILES=twitch
# Host folder for the library. Jellyfin reads it, so it needs read access.
# TWITCH_LIBRARY_HOST_PATH=/path/to/twitch
# Owner of the library files. Jellyfin's user must be in the TWITCH_PGID group to delete them.
# TWITCH_PUID=1000
# TWITCH_PGID=1000
# Host group that owns /dev/dri/renderD128, for the nightly re-encode: getent group render
# TWITCH_RENDER_GID=992

# --- Optional: YouTube ---
# Uses the same worker, so this starts it too: COMPOSE_PROFILES=youtube
# With Twitch as well: COMPOSE_PROFILES=twitch,youtube
# Host folder for the videos. Without one, YouTube stays not ready and Twitch is unaffected.
# YOUTUBE_LIBRARY_HOST_PATH=/path/to/youtube
