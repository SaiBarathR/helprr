generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  SONARR
  RADARR
  QBITTORRENT
  PROWLARR
  JELLYFIN
  TMDB
  ANILIST
  SEERR
  LIDARR
  TWITCH
}

enum UserRole {
  admin
  member
}

enum UserStatus {
  active
  pending
  disabled
}

model User {
  id             String     @id @default(cuid())
  username       String     @unique
  displayName    String
  passwordHash   String? // nullable → Jellyfin-only accounts (local login impossible, JF login works)
  role           UserRole   @default(member)
  status         UserStatus @default(active)
  template       String     @default("member") // "admin" | "member" — preset the overrides layer on
  permissions    Json       @default("{}") // Partial<Record<Capability, boolean>> — DELTAS only
  jellyfinUserId String?    @unique
  seerrUserId    String?    @unique
  jellyfinToken  String? // the member's Jellyfin AccessToken that playback is signed with; encrypted (enc:v1:), written by Jellyfin sign-in and Settings → Account; not a Helprr login credential
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  watchlistItems WatchlistItem[]
  watchlistTags  WatchlistTag[]
  pushSubscriptions PushSubscription[]
  notificationHistory NotificationHistory[]
  pendingRequests PendingRequest[]
  dashboardLayouts DashboardLayout[]
  aniListLink    UserAniListLink?
  settings       UserSettings?
  scheduledAlerts ScheduledAlert[]
  recommendationEvents RecommendationEvent[]
  twitchSubscriptions TwitchSubscription[]
  twitchVideoStates TwitchUserVideoState[]
  twitchLink TwitchUserLink?
  tasteProfile   UserTasteProfile?

  @@index([jellyfinUserId])
  @@index([status])
}

model ServiceConnection {
  id             String      @id @default(cuid())
  type           ServiceType
  label          String // user-facing instance name ("HD", "4K", "Anime"); for single-instance types defaults to the service name
  isDefault      Boolean     @default(false) // exactly one true per type, enforced in arr-instances.ts
  url            String
  apiKey         String
  username       String?
  externalUrl    String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  metadata       Json?
  customHeaders  Json? // optional { name: value } map sent on outbound requests (reverse-proxy auth); gated by HELPRR_CUSTOM_HEADERS
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  pollingState   PollingState?
  manualDownloads ManualDownload[]

  @@unique([type, label])
  @@index([type])
}

model Session {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ip         String?
  label      String?
  revokedAt  DateTime?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([revokedAt])
  @@index([userId])
}

model WatchlistItem {
  id                 String         @id @default(cuid())
  // Nullable so `db push` can add it to a populated table non-destructively;
  // ensureBootstrapAdmin() backfills existing rows to the admin on boot, and
  // every write sets it. The unique below is per-user.
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source             String
  externalId         String
  mediaType          String
  title              String
  year               Int?
  posterUrl          String?
  overview           String?
  rating             Float?
  addedAt            DateTime       @default(now())
  reminderAt         DateTime?
  reminderNotifiedAt DateTime?
  reminderAttempts   Int            @default(0)
  tags               WatchlistTag[] @relation("WatchlistItemTags")

  @@unique([userId, source, externalId, mediaType])
  @@index([userId, addedAt])
  @@index([reminderAt, reminderNotifiedAt])
}

model WatchlistTag {
  id     String          @id @default(cuid())
  // Per-user: tags are a private vocabulary, never shared across accounts.
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  color  String?
  items  WatchlistItem[] @relation("WatchlistItemTags")

  @@unique([userId, name])
  @@index([userId])
}

// User-defined scheduled alert rules (custom date/time or release-relative).
model ScheduledAlert {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        String   // TMDB | TVDB | ANILIST | SONARR | RADARR
  externalId    String
  mediaType     String   // movie | series | anime
  instanceId    String?
  title         String
  subtitle      String?
  posterUrl     String?
  href          String?
  scheduleMode  String   // absolute | release_relative
  scope         String   // movie | series | season | episode | anime
  releaseTypes  Json     @default("[]") // cinema | digital | physical | episode | season, etc.
  offsetMinutes Int      @default(0)
  timeZone      String   @default("UTC")
  status        String   @default("active") // active | cancelled
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cancelledAt   DateTime?
  occurrences   ScheduledAlertOccurrence[]

  @@index([userId, status, createdAt])
  @@index([userId, source, externalId, mediaType])
}

// Concrete alert instances generated from a ScheduledAlert rule.
model ScheduledAlertOccurrence {
  id           String         @id @default(cuid())
  alertId      String
  alert        ScheduledAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  releaseAt    DateTime?
  notifyAt     DateTime
  releaseKind  String         // custom | cinema | digital | physical | episode | season | airing
  targetKey    String
  title        String
  body         String?
  metadata     Json?
  status       String         @default("pending") // pending | sent | failed | cancelled
  attempts     Int            @default(0)
  lastAttemptAt DateTime?
  sentAt       DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([alertId, targetKey, notifyAt])
  @@index([status, notifyAt])
  @@index([alertId, status, notifyAt])
}

model PushSubscription {
  id                  String                   @id @default(cuid())
  // Nullable for non-destructive `db push`; set at subscribe time and
  // backfilled to the admin on boot. endpoint stays globally unique.
  userId              String?
  user                User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint            String                   @unique
  p256dh              String
  auth                String
  deviceName          String?
  consecutiveFailures Int                      @default(0)
  lastFailedAt        DateTime?
  lastSucceededAt     DateTime?
  revokedAt           DateTime?
  createdAt           DateTime                 @default(now())
  preferences         NotificationPreference[]

  @@index([userId])
}

model NotificationPreference {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String
  enabled        Boolean          @default(true)
  tagFilter      String?
  qualityFilter  String?
  // Comma-separated Jellyfin user names/ids whose playback never notifies this
  // device (jellyfinPlaybackStart only)
  mutedUserFilter String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([subscriptionId, eventType])
}

model NotificationHistory {
  id        String   @id @default(cuid())
  // Nullable on purpose: ownership-scoped events (watchlist reminders, a
  // member's request updates) stamp the owner; instance/infrastructure events
  // (imports, health, cleanup) stay null = admin/global. Avoids a hard backfill.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  title     String
  body      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  dedupeKey String?

  // Unique so the history insert is the atomic dedupe gate: a concurrent
  // writer racing the prefetch hits P2002 instead of double-sending. NULL
  // dedupeKeys (non-deduped events) are distinct in Postgres, so unaffected.
  @@unique([eventType, dedupeKey])
  // Covers the upcomingPremiere dedupe prefetch in polling-service
  // (eventType equality + createdAt range) so it seeks the slice instead of
  // range-scanning createdAt and filtering eventType in memory.
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model PollingState {
  id                  String            @id @default(cuid())
  serviceConnectionId String            @unique
  connection          ServiceConnection @relation(fields: [serviceConnectionId], references: [id], onDelete: Cascade)
  lastQueueIds        Json?             // null = queue baseline not yet captured (first-run marker; see getPollingState)
  lastHistoryDate     DateTime?
  lastHistoryId       Int?              // max history id at lastHistoryDate; tie-breaks same-timestamp records
  lastHistorySeenIds  Json              @default("[]") // ids seen at lastHistoryDate; caps same-ts burst gaps
  lastHealthHash      String?
  lastReachable       Boolean?          // null = not yet probed; used for service up/down transition alerts
  updatedAt           DateTime          @updatedAt
}

// Daily disk-usage samples powering the storage widget's growth trend +
// "days until full" estimate. Keyed by the canonical diskId() identity so a
// disk's history survives label/path drift. The sampler writes at most one row
// per disk per local day and prunes rows older than the retention window.
model DiskUsageSnapshot {
  id           String   @id @default(cuid())
  diskId       String
  label        String?
  path         String
  totalSpace   BigInt
  freeSpace    BigInt
  capturedAt   DateTime @default(now())
  capturedDate DateTime @default(now()) @db.Date

  @@unique([diskId, capturedDate])
  @@index([diskId, capturedAt])
  @@index([capturedAt])
}

model AppSettings {
  id                       String  @id @default("singleton")
  pollingIntervalSecs      Int     @default(30)
  activityRefreshIntervalSecs  Int @default(5)
  torrentsRefreshIntervalSecs  Int @default(5)
  cacheImagesEnabled       Boolean @default(true)
  timeZone                 String  @default("UTC")
  logEnabled               Boolean @default(true)
  logLevel                 String  @default("debug")
  logMaxFileMb             Int     @default(50)
  logRetentionDays         Int     @default(30)
  notificationHistoryRetentionDays Int @default(90)
  logClientConsoleEnabled  Boolean @default(true)
  logFailedRequestBodies   Boolean @default(false)
  logFailedResponseBodies  Boolean @default(false)
  upcomingNotifyMode       String  @default("before_air") // "before_air" | "daily_digest"
  upcomingNotifyBeforeMins Int     @default(60)           // 0 = at air time
  upcomingDailyNotifyHour  Int     @default(9)            // 0-23, for daily_digest mode
  watchProviderRegion      String  @default("US")         // ISO 3166-1 alpha-2 country for TMDB watch providers
  activityDigestMode       String  @default("off")        // "off" | "daily" | "weekly"
  activityDigestHour       Int     @default(8)            // 0-23, hour of day to fire the digest
  activityDigestDayOfWeek  Int     @default(1)            // 0=Sun..6=Sat, used when mode=weekly
  notificationGroupingEnabled Boolean @default(true)      // collapse same-type per-poll bursts (e.g. a season pack) into one grouped notification
  animeAutoMapEnabled      Boolean  @default(true)         // nightly job that auto-maps never-mapped Sonarr anime to AniList
  animeAutoMapHour         Int      @default(0)            // 0-23 local hour the nightly drain starts (default midnight)
  animeAutoMapLastRunAt    DateTime?                       // server-managed: when the last nightly drain completed
  // AniList API cache TTLs in minutes, per policy class. Stale-serve windows
  // scale with each class's default ratio (sections/browse ×6, detail ×7, airing ×3).
  anilistSectionsTtlMin    Int     @default(5)             // home / trending / seasonal rails
  anilistBrowseTtlMin      Int     @default(10)            // search + browse results
  anilistDetailTtlMin      Int     @default(1440)          // anime/manga/staff/character/studio details
  anilistAiringTtlMin      Int     @default(10)            // next-airing + airing schedule
  qbtBandwidthSchedule     Json?                          // Bandwidth-schedule rules applied to qBittorrent global limits
  diskThresholds           Json?                          // [{ diskId, label, path, minFreeGb, enabled }] — per-disk low-space alert config
  diskAlertState           Json?                          // { [diskId]: { below, lastAlertAt } } — server-managed low-space alert bookkeeping
  discoverLayout           Json?                          // User-configured discover homepage layout (sections order, visibility, custom carousels)
  defaultDesktopLayoutId   String?                        // Active DashboardLayout for desktop viewport
  defaultMobileLayoutId    String?                        // Active DashboardLayout for mobile viewport

  defaultDesktopLayout DashboardLayout? @relation("DesktopDefault", fields: [defaultDesktopLayoutId], references: [id], onDelete: SetNull)
  defaultMobileLayout  DashboardLayout? @relation("MobileDefault", fields: [defaultMobileLayoutId], references: [id], onDelete: SetNull)
}

model DashboardLayout {
  id        String   @id @default(cuid())
  // null = global/admin layout (the shared built-ins); non-null = a member's
  // own personal layout. Each user manages only their own scope.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  widgets   Json     // WidgetInstance[]
  isBuiltIn Boolean  @default(false)
  // Only the two global built-ins use 'desktop'/'mobile'; per-user layouts are
  // null (Postgres @unique permits multiple NULLs).
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desktopDefaults AppSettings[] @relation("DesktopDefault")
  mobileDefaults  AppSettings[] @relation("MobileDefault")

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Per-user AniList token + identity. The global ServiceConnection(type=ANILIST)
// keeps holding the app credential (clientId/secret); this holds each member's
// OAuth tokens (encrypted) and resolved AniList identity.
model UserAniListLink {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken    String? // encrypted (enc:v1:)
  refreshToken   String? // encrypted (enc:v1:)
  tokenExpiresAt DateTime?
  anilistUserId  Int?
  username       String?
  avatar         String?
  siteUrl        String?
  scoreFormat    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Genuinely-personal settings. Every column is nullable = "inherit AppSettings".
// getUserSettings() coalesces these against the global singleton.
model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeZone               String?
  upcomingNotifyMode     String?
  activityDigestMode     String?
  defaultDesktopLayoutId String?
  defaultMobileLayoutId  String?
  quietHoursEnabled      Boolean  @default(false) // when true, suppress non-critical pushes during the window
  quietHoursStart        Int?                      // 0-23 local hour (in this user's timeZone) the window opens
  quietHoursEnd          Int?                      // 0-23 local hour the window closes; start > end = crosses midnight
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Helprr-side approval gate for Seerr requests. Jellyseerr's API auto-approves
// anything created with the admin key (approval is tied to the authenticating
// user, not the attributed one), so a member's request is parked here until an
// admin approves it — at which point it's created in Seerr and this row deleted.
// Transient: only pending rows ever exist (approve/decline remove them).
model PendingRequest {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType         String // 'movie' | 'tv'
  tmdbId            Int
  title             String?
  posterUrl         String?
  is4k              Boolean  @default(false)
  seasons           Json? // number[]
  serverId          Int?
  profileId         Int?
  rootFolder        String?
  languageProfileId Int?
  tags              Json? // number[]
  seerrUserId       String? // attributed member's Seerr user id (snapshot)
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ==================== Recommendations: learning pipeline ====================

// Per-user recommendation interaction log — the raw signal stream the taste
// profile learns from. itemKey is the canonical cross-source identity
// ("tmdb:movie:<id>" | "tmdb:tv:<id>" | "anilist:<id>") so one title keeps one
// history regardless of which surface produced the event. Rows are pruned by
// retention (impressions 90d, clicks/plays 365d); explicit feedback
// (like/dislike/not_interested) is kept forever — "never show me this again"
// must not expire.
model RecommendationEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey   String
  // impression | click | play | like | love | dislike | not_interested |
  // watchlist_add | request — validated at the API layer.
  eventType String
  // Rail/surface that produced the event ("top-picks", "because:tmdb:tv:1399",
  // "feed", "random"), so exploration slots can be measured per rail.
  railId    String?
  context   Json?    // { position, mode: 'rails'|'feed', exploration?: true }
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, itemKey, eventType])
  // Retention prunes by type+age across all users.
  @@index([eventType, createdAt])
}

// Cached output of the per-user profile build (genre/mood vectors, seeds,
// negatives). Versioned JSON — bump `version` when the payload shape changes so
// stale rows rebuild instead of misparse. Durable in Postgres (not Redis): a
// profile is expensive to build (Jellyfin scans + Playback Reporting + AniList)
// and must survive restarts/cache purges.
model UserTasteProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Json
  version   Int      @default(1)
  builtAt   DateTime @default(now())
  /// When a link change last asked for a rebuild (markTasteProfileStale); a rebuild that started earlier stays stale.
  markedAt  DateTime?
  updatedAt DateTime @updatedAt
}

model AniListSeriesMapping {
  id                   String   @id @default(cuid())
  sonarrInstanceId     String
  sonarrSeriesId       Int
  state                String
  matchMethod          String?
  confidence           Int?
  seriesTitleSnapshot  String
  seriesYearSnapshot   Int?
  seriesTvdbIdSnapshot Int?
  seriesTmdbIdSnapshot Int?
  resolvedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // 1 Sonarr series → N AniList entries (season-split anime). Matched states have
  // ≥1 entry; AUTO_UNMATCHED / MANUAL_NONE have none.
  entries              AniListSeriesMappingEntry[]

  // A series id is only unique within a Sonarr instance, so scope by instance.
  @@unique([sonarrInstanceId, sonarrSeriesId])
  @@index([sonarrInstanceId])
}

model AniListSeriesMappingEntry {
  id             String               @id @default(cuid())
  mappingId      String
  mapping        AniListSeriesMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  anilistMediaId Int
  isPrimary      Boolean              @default(false) // exactly one true per mapping
  order          Int                  @default(0) // tab order on the series detail page
  source         String               @default("manual") // 'auto' | 'manual' — who created the link
  titleSnapshot  String? // AniList preferred title at link time (admin list renders without API calls)
  createdAt      DateTime             @default(now())

  @@unique([mappingId, anilistMediaId])
  @@index([anilistMediaId]) // reverse lookup: AniList entry → Sonarr series
}

// ==================== Cleanup: Queue Cleaner ====================

model QueueCleanerConfig {
  id                            String   @id @default("singleton")
  enabled                       Boolean  @default(false)
  intervalMinutes               Int      @default(5)
  ignoredDownloads              Json     @default("[]")
  processNoContentId            Boolean  @default(false)
  downloadingMetadataMaxStrikes Int      @default(0)
  failedImport                  Json     @default("{}")
  reSearchAfterRemoval          Boolean  @default(true)
  // "disabled" (default — no auto cycles), "dryRun" (auto cycles, log only), "enabled" (auto delete)
  autoRunMode                   String   @default("disabled")
  updatedAt                     DateTime @updatedAt
}

model StallRule {
  id                      String   @id @default(cuid())
  name                    String
  enabled                 Boolean  @default(true)
  priority                Int      @default(0)
  maxStrikes              Int      @default(3)
  privacyType             String   @default("public")
  minCompletionPercentage Int      @default(0)
  maxCompletionPercentage Int      @default(100)
  resetStrikesOnProgress  Boolean  @default(true)
  minimumProgressBytes    BigInt?
  changeCategory          Boolean  @default(false)
  deletePrivate           Boolean  @default(false)
  reSearchOverride        Boolean?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model SlowRule {
  id                      String   @id @default(cuid())
  name                    String
  enabled                 Boolean  @default(true)
  priority                Int      @default(0)
  maxStrikes              Int      @default(3)
  privacyType             String   @default("public")
  minCompletionPercentage Int      @default(0)
  maxCompletionPercentage Int      @default(100)
  minSpeedKbps            Int?
  maxTimeHours            Float?
  ignoreAboveSizeBytes    BigInt?
  resetStrikesOnProgress  Boolean  @default(true)
  changeCategory          Boolean  @default(false)
  deletePrivate           Boolean  @default(false)
  reSearchOverride        Boolean?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ==================== Cleanup: Download Cleaner ====================

model DownloadCleanerConfig {
  id                            String   @id @default("singleton")
  enabled                       Boolean  @default(false)
  intervalMinutes               Int      @default(60)
  ignoredDownloads              Json     @default("[]")
  autoRemoveImportedEnabled     Boolean  @default(false)
  autoRemoveImportedCategories  Json     @default("[\"sonarr\",\"radarr\",\"tv-sonarr\"]")
  autoRemoveImportedDeleteFiles Boolean  @default(true)
  // 'public' | 'private' | 'both'. Controls which trackers the system rule
  // applies to. Default 'public' matches historical behaviour.
  autoRemoveImportedPrivacyType String   @default("public")
  // "disabled" (default — no auto cycles), "dryRun" (auto cycles, log only), "enabled" (auto delete)
  autoRunMode                   String   @default("disabled")
  updatedAt                     DateTime @updatedAt
}

model SeedingRule {
  id                String   @id @default(cuid())
  name              String
  enabled           Boolean  @default(true)
  priority          Int      @default(0)
  categories        Json     @default("[]")
  trackerPatterns   Json     @default("[]")
  tagsAny           Json     @default("[]")
  tagsAll           Json     @default("[]")
  privacyType       String   @default("both")
  maxRatio          Float    @default(-1)
  minSeedTimeHours  Float    @default(0)
  maxSeedTimeHours  Float    @default(-1)
  deleteSourceFiles Boolean  @default(true)
  // When true, deletion is gated on Sonarr/Radarr history confirming a
  // successful import for this torrent. The ratio/seedtime predicate still
  // applies on top, so users can compose "imported AND seeded N hours".
  // Mutually exclusive with DownloadCleanerConfig.autoRemoveImportedEnabled
  // (enforced at the API layer).
  requireImportedConfirmation Boolean @default(false)
  isSystem          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==================== Cleanup: shared ====================

model CleanupStrike {
  id                  String   @id @default(cuid())
  hash                String
  torrentName         String
  ruleId              String?
  strikeType          String
  count               Int      @default(0)
  lastDownloadedBytes BigInt?
  // When qBittorrent added the torrent these strikes were counted for, so a
  // re-added copy of the same hash starts from none. Null on older rows.
  torrentAddedAt      DateTime?
  lastSeenAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([hash, strikeType, ruleId])
  @@index([hash])
}

enum CleanupAction {
  strikeAdded
  removedFromClient
  removedFromQueue
  categoryChanged
  skipped
  dryRunPreview
  failed
}

model CleanupHistory {
  id              String        @id @default(cuid())
  cleaner         String
  strikeType      String?
  ruleId          String?
  ruleName        String?
  hash            String
  shortHash       String
  torrentName     String
  reason          String
  action          CleanupAction
  filesDeleted    Boolean
  reSearched      Boolean
  linkedArrSource String?
  linkedArrTitle  String?
  linkedArrItemId Int?
  torrentSize     BigInt?
  torrentProgress Float?
  torrentRatio    Float?
  triggeredBy     String
  errorMessage    String?
  // Manual cleanup safety metadata. previewId is a non-secret correlation id;
  // the single-use preview token itself is short-lived in Redis and is never
  // persisted. Legacy rows keep these fields null.
  previewId       String?
  outcomeStatus   String?
  outcomeDetails  Json?
  // Who ran the cycle, denormalized like FileOperationAudit so it outlives the
  // user: the signed-in user for previews and manual runs, a null id with
  // "system:cleanup-scheduler" for scheduled runs. Legacy rows keep both null.
  actorUserId     String?
  actorUsername   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([hash])
  @@index([action])
  @@index([previewId])
}

// ==================== File operations: audit trail ====================

enum FileOperation {
  EDIT // bulk metadata edit (quality / language / release group / flags / release type / edition)
  DELETE // remove file(s) from disk (recycle bin or permanent, per the *arr config)
  IMPORT // manual import of loose/unmapped files (moves + renames on disk)
  DELETE_MEDIA // remove a series / movie / artist / album, optionally with files
  DELETE_TORRENT // remove one or more torrents, optionally with downloaded data
  REMOVE_QUEUE // remove an Arr queue item, optionally from the download client
  CREATE_MEDIA // add a series / movie to an Arr library (manual downloads)
  PUSH_RELEASE // hand a magnet / .torrent to an Arr instance as a manual release
}

// Unified accountability log for file operations and destructive media/download
// operations. Each authorized, validated upstream attempt of an audited operation
// — success OR failure — is recorded, fail-soft, with the actor (renames are not
// audited; see docs/architecture.md). userId is intentionally not a FK and username
// is denormalized so the row outlives the user it references.
model FileOperationAudit {
  id           String        @id @default(cuid())
  userId       String? // acting user id at the time (not a FK — see above)
  username     String // denormalized actor, retained after user deletion; "system:<label>" for scheduled work
  service      ServiceType // SONARR | RADARR | LIDARR | QBITTORRENT
  instanceId   String? // which ServiceConnection instance the op ran against
  operation    FileOperation
  mediaType    String // generic target type: series | movie | artist | album | torrent | queue
  mediaId      Int? // numeric target id when one exists; torrent hashes live in details
  mediaTitle   String
  fileCount    Int // operation item count (legacy rows use number of files)
  filesDeleted Boolean? // true/false when the operation exposes a delete-files/data choice
  details      Json? // target ids/hashes, paths, options, field deltas, command ids, per-item results
  success      Boolean
  errorMessage String?
  requestId    String? // x-request-id of the API request that ran it; null for scheduled work and legacy rows
  startedAt    DateTime? // when the upstream call started; null on legacy rows
  createdAt    DateTime      @default(now()) // written as soon as the result is known

  @@index([createdAt])
  @@index([service, mediaId])
  @@index([userId, createdAt])
}

// Manual downloads: a hand-supplied magnet or .torrent linked to a Sonarr/Radarr
// title. In the default (ARR_MANAGED) mode Arr owns the download: Helprr adds
// the title with searches off, pushes the release, and follows Arr's queue,
// history and file records. QBIT_REVIEWED is the advanced fallback (files are
// chosen in qBittorrent first). See docs/upstream-compatibility.md.
enum ManualDownloadMode {
  ARR_MANAGED
  QBIT_REVIEWED
}

enum ManualDownloadStatus {
  PREFLIGHT
  CREATING_MEDIA
  SUBMITTING_RELEASE
  QUEUED
  DOWNLOADING
  IMPORT_PENDING
  IMPORTING
  IMPORTED
  NEEDS_MAPPING
  BLOCKED
  FAILED
  CANCELLED
}

enum ManualDownloadSource {
  MAGNET
  TORRENT_FILE
}

model ManualDownload {
  id                 String                @id @default(cuid())
  mode               ManualDownloadMode
  status             ManualDownloadStatus
  service            ServiceType // SONARR | RADARR
  instanceId         String? // the Arr instance; null once that connection is deleted
  instance           ServiceConnection?    @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceLabel      String // denormalized, kept after the connection is gone
  externalId         Int // tmdbId (Radarr) or tvdbId (Sonarr)
  arrItemId          Int? // movie / series id in that instance, once known
  arrItemTitle       String
  createdArrItem     Boolean               @default(false) // this workflow added the item (compensation may remove it)
  targetEpisodeIds   Int[] // Sonarr: the episodes the release covers, as Arr parsed them
  releaseTitle       String // the title pushed to Arr, which Arr parses to map the release
  source             ManualDownloadSource
  infoHash           String // v1 info hash, uppercase hex (Arr's downloadId)
  torrentName        String
  downloadClientId   Int?
  downloadClientName String?
  arrQueueId         Int?
  baselineFileIds    Json // the target's file ids before the download, to prove an import
  importedFileIds    Json?
  lastError          String?
  attempts           Int                   @default(0)
  clientRequestId    String // idempotency key from the submitting client
  createdByUserId    String? // acting user (not a FK; see FileOperationAudit)
  createdByUsername  String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  completedAt        DateTime?
  pathMapping        Json? // fallback: { mapping } — the remote path mapping Arr reads the files through, null for the same path
  arrCommandId       Int? // fallback: the ManualImport command Helprr started
  importSentAt       DateTime? // fallback: when the import under the current claim was sent; cleared once it is settled
  events             ManualDownloadEvent[]
  files              ManualDownloadFile[]

  @@unique([createdByUserId, clientRequestId])
  @@index([status, updatedAt])
  @@index([instanceId, infoHash])
}

enum ManualDownloadFileDecision {
  PENDING
  IMPORT
  IGNORE
}

// Fallback mode: the torrent's files exactly as chosen before the download, and what happens to each.
model ManualDownloadFile {
  id         String                     @id @default(cuid())
  downloadId String
  download   ManualDownload             @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  fileIndex  Int // qBittorrent's index of the file in the torrent
  path       String // the file's path inside the torrent, as qBittorrent names it
  size       BigInt
  selected   Boolean
  arrPath    String? // where Arr sees the file once it is downloaded
  candidate  Json? // Arr's manual-import reading of it: mapping, quality, languages, rejections
  decision   ManualDownloadFileDecision @default(PENDING)
  episodeIds Int[] // Sonarr: the episodes confirmed for it

  @@unique([downloadId, fileIndex])
}

model ManualDownloadEvent {
  id         String               @id @default(cuid())
  downloadId String
  download   ManualDownload       @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  at         DateTime             @default(now())
  status     ManualDownloadStatus
  message    String?
  details    Json?

  @@index([downloadId, at])
}

enum TwitchVideoType {
  ARCHIVE
  HIGHLIGHT
  UPLOAD
  CLIP
}

enum TwitchVideoAvailability {
  RECORDING
  PUBLISHED
  UNAVAILABLE
}

enum TwitchJobKind {
  DOWNLOAD
  REENCODE
  DELETE_FILES
}

enum TwitchJobState {
  QUEUED
  BLOCKED
  RUNNING
  RETRY_WAIT
  DONE
  FAILED
  CANCELLED
}

enum TwitchJobSource {
  MANUAL
  RULE
  URGENCY
  URL
}

// Singleton. Kept apart from AppSettings because GET /api/settings returns that row to any signed-in user.
model TwitchSettings {
  id                        String    @id @default("singleton")
  autoDownloadEnabled       Boolean   @default(false) // hard override: while false, nothing downloads by itself
  defaultPolicy             Json      @default("{}") // global policy layer
  typePolicies              Json      @default("{}") // per-video-type policy layers
  jellyfinLibraryPath       String? // the library root as Jellyfin sees it, not the worker's mount
  jellyfinLibraryItemId     String?
  pollLiveSecs              Int       @default(60)
  pollVideosSecs            Int       @default(300)
  lastLivePollAt            DateTime? // DB-backed throttle, so a restart does not reset it
  maxConcurrentDownloads    Int       @default(2)
  minFreeGb                 Int       @default(50) // a download that would leave less than this is BLOCKED
  reencodeEnabled           Boolean   @default(true)
  reencodeGlobalQuality     Int       @default(20)
  reencodePreset            String    @default("faster")
  reencodeWindowStart       String    @default("01:00") // HH:mm in the server TZ
  reencodeWindowEnd         String    @default("08:00") // HH:mm in the server TZ
  keepOriginalDays          Int       @default(3)
  jellyfinBusyUntil         DateTime? // set by the app while Jellyfin transcodes; the worker starts no re-encode
  browserAuthToken          String? // enc:v1 twitch.tv auth-token cookie; never returned by any API
  browserAuthTokenCheckedAt DateTime?
  browserAuthTokenValid     Boolean? // null until the first daily check
  pinnedTools               Json      @default("{}") // tool name -> pinned version
  toolLatest                Json      @default("{}") // tool name -> newest release, from the daily check
  toolCheckedAt             DateTime?
  extractorFailures         Int       @default(0) // in a row, across jobs
  toolsPausedAt             DateTime? // downloads wait: Twitch probably changed something the tools rely on
  toolUpdateRequestedAt     DateTime? // set by the app, cleared by the worker
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model TwitchStreamer {
  id                String                @id @default(cuid())
  twitchUserId      String                @unique
  login             String
  folderName        String                @unique // library folder; set once at first add, never renamed
  displayName       String
  description       String?
  profileImageUrl   String?
  offlineImageUrl   String?
  broadcasterType   String                @default("") // partner, affiliate or empty, as Helix reports it
  isLive            Boolean               @default(false)
  liveStreamId      String?
  liveTitle         String?
  liveCategory      String?
  liveMissedChecks  Int                   @default(0) // offline only after it is absent twice
  lastLiveAt        DateTime?
  baselinedAt       DateTime? // null until the first sweep recorded existing videos without notifying
  nextVideosCheckAt DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  subscriptions     TwitchSubscription[]
  policy            TwitchStreamerPolicy?
  videos            TwitchVideo[]

  @@index([nextVideosCheckAt])
}

model TwitchSubscription {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamerId    String
  streamer      TwitchStreamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  notifyNewVods Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, streamerId])
  @@index([streamerId])
}

model TwitchStreamerPolicy {
  id           String         @id @default(cuid())
  streamerId   String         @unique
  streamer     TwitchStreamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  policy       Json           @default("{}") // streamer layer
  typePolicies Json           @default("{}") // streamer x video type layers
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model TwitchVideo {
  id                 String                  @id @default(cuid())
  twitchVideoId      String                  @unique
  streamerId         String
  streamer           TwitchStreamer          @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  type               TwitchVideoType
  title              String
  description        String?
  twitchCreatedAt    DateTime
  publishedAt        DateTime?
  durationSeconds    Int
  thumbnailUrl       String?
  category           String? // from the live stream or the chapters; Helix has none for a video
  viewCount          Int                     @default(0)
  language           String?
  streamId           String? // equals the live stream id while the archive is still recording
  mutedSegments      Json? // Helix muted_segments: audio Twitch removed and that cannot be recovered
  chapters           Json? // from the download: Helix has none
  availability       TwitchVideoAvailability @default(PUBLISHED)
  estimatedExpiresAt DateTime? // archives only; an estimate, because Prime/Turbo status is not visible
  firstSeenAt        DateTime                @default(now())
  lastSeenAt         DateTime                @default(now())
  missingSweeps      Int                     @default(0)
  notifiedAt         DateTime?
  expiryNotifiedAt   DateTime?
  seasonEpisode      Int? // highlights and uploads: assigned at publish, never renumbered
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  userStates         TwitchUserVideoState[]
  jobs               TwitchJob[]
  mediaFiles         TwitchMediaFile[]

  @@index([streamerId, twitchCreatedAt])
  @@index([availability, estimatedExpiresAt])
}

model TwitchUserVideoState {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     TwitchVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  seenAt    DateTime?
  hidden    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, videoId])
  @@index([videoId])
}

// The app enqueues, the worker claims with a lease. A restart of either side loses nothing.
model TwitchJob {
  id                   String           @id @default(cuid())
  kind                 TwitchJobKind
  videoId              String?
  video                TwitchVideo?     @relation(fields: [videoId], references: [id], onDelete: SetNull)
  mediaFileId          String?
  mediaFile            TwitchMediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  state                TwitchJobState   @default(QUEUED)
  source               TwitchJobSource  @default(MANUAL)
  priority             Int              @default(0) // higher runs first
  options              Json             @default("{}") // resolved policy, frozen at enqueue
  trace                Json? // which policy layer set each option
  requestedByUserId    String?
  requestedByUsername  String?
  clientRequestId      String?
  attempts             Int              @default(0)
  runAfter             DateTime         @default(now())
  leaseOwner           String?
  leaseUntil           DateTime?
  cancelRequested      Boolean          @default(false)
  stage                String?
  progress             Float?
  speedBps             Float?
  etaSeconds           Int?
  bytesDone            BigInt?
  bytesTotal           BigInt?
  errorClass           String?
  lastError            String? // redacted
  needsJellyfinRefresh Boolean          @default(false)
  failureNotifiedAt    DateTime? // set by the app, which alone holds the push keys
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  events               TwitchJobEvent[]

  @@unique([requestedByUserId, clientRequestId])
  @@index([state, kind, priority, runAfter])
  @@index([videoId])
  @@index([needsJellyfinRefresh])
}

model TwitchJobEvent {
  id        String    @id @default(cuid())
  jobId     String
  job       TwitchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String
  message   String // redacted before it is written
  createdAt DateTime  @default(now())

  @@index([jobId, createdAt])
  @@index([createdAt])
}

model TwitchMediaFile {
  id                   String      @id @default(cuid())
  videoId              String
  video                TwitchVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  relativePath         String      @unique // under the library root; never sent to the browser
  sidecars             Json        @default("[]")
  sizeBytes            BigInt
  durationSeconds      Int
  videoCodec           String
  height               Int?
  reencodedAt          DateTime?
  originalRelativePath String?
  originalDeleteAfter  DateTime?
  keepForever          Boolean     @default(false)
  jellyfinItemId       String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  jobs                 TwitchJob[]

  @@index([videoId])
  @@index([originalDeleteAfter])
}

model TwitchWorkerHeartbeat {
  id             String   @id @default(cuid())
  workerId       String   @unique
  version        String
  tools          Json     @default("{}")
  gpuAvailable   Boolean  @default(false)
  diskFreeBytes  BigInt?
  diskTotalBytes BigInt?
  lanes          Json     @default("{}")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A user's own Twitch sign-in, only to read who they follow. Every token is enc:v1.
model TwitchUserLink {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  twitchUserId   String?
  login          String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  deviceCode     String? // while waiting for the code to be entered at twitch.tv/activate
  deviceExpires  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
